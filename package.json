{
  "name": "job-apply-agent",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "setup:browser": "playwright install chromium",
    "typecheck": "tsc -b",
    "console:check": "tsx scripts/check_console_syntax.ts",
    "console:scope": "tsx scripts/check_console_scope.ts",
    "mp:check": "tsx scripts/mp_check.ts",
    "mp:icons": "python scripts/make_tabbar_icons.py",
    "mp:probe": "tsx scripts/_mp_api_probe.mts",
    "auth:verify": "tsx scripts/_auth_leak_verify.mts",
    "auth:static": "tsx scripts/_static_auth_verify.mts",
    "auth:console": "tsx scripts/_console_auth_verify.mts",
    "auth:img": "tsx scripts/_img_path_verify.mts",
    "auth:all": "npm run auth:verify && npm run auth:static && npm run auth:img && npm run auth:console",
    "bat:check": "tsx scripts/bat_encoding.ts check",
    "bat:fix": "tsx scripts/bat_encoding.ts fix",
    "pii:check": "git -c core.quotePath=false ls-files | tsx scripts/pii_guard.ts --stdin",
    "selftest": "tsx scripts/selftest.ts",
    "test:contract": "tsx scripts/contract_tests.ts",
    "test:unit": "node scripts/unit_run.mjs",
    "test": "npm run selftest && npm run test:contract && npm run test:unit",
    "verify": "npm run typecheck && npm run console:check && npm run console:scope && npm run mp:check && npm run guide:check",
    "db:report": "tsx scripts/db_report.ts",
    "db:fix": "tsx scripts/fix_job_data.ts",
    "data:cleanup": "tsx scripts/cleanup_data.ts",
    "jobs:backfill-jd": "tsx scripts/backfill_jd.ts",
    "hooks:install": "git config core.hooksPath .githooks && echo \"已启用 .githooks/（pre-push 会跑 typecheck + console:check + mp:check + pii:check）\"",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --no-bundle",
    "app:bundle": "tauri build",
    "guide:check": "tsx scripts/guide_check.ts",
    "guide:e2e": "tsx scripts/guide_e2e.ts",
    "relay:e2e": "tsx scripts/relay_e2e.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@tdesign-react/aigc": "^0.1.0-alpha.1",
    "@tdesign-react/chat": "^1.0.2",
    "@tencent-ai/agent-sdk": "^0.3.43",
    "better-sqlite3": "^12.6.2",
    "express": "^4.18.2",
    "imapflow": "^1.0.188",
    "lucide-react": "^0.563.0",
    "mailparser": "^3.7.1",
    "mammoth": "^1.12.2",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.49.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "tdesign-icons-react": "^0.5.0",
    "tdesign-react": "^1.12.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "acorn": "^8.18.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "less": "^4.3.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vite": "^5.0.10"
  }
}
