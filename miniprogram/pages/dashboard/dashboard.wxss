.hero {
  padding-bottom: 24rpx;
}

.metrics {
  margin-top: 24rpx;
}

.metric-num {
  font-variant-numeric: tabular-nums;
}

.progress-line {
  margin-top: 20rpx;
}

.progress-bar {
  height: 12rpx;
  background: #eef1f5;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #ff7a45;
  border-radius: 999rpx;
  transition: width 0.3s;
}

.mt8 { margin-top: 8rpx; }
.mt24 { margin-top: 28rpx; }

.alert-card {
  border-color: #f6c9ca;
  background: #fffafa;
}

.err-card {
  border-color: #f6c9ca;
}

.err-text {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #e5484d;
  line-height: 1.6;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.actions .btn { flex: 1; }

.btn.wide {
  margin-top: 24rpx;
  width: 100%;
}

.kv {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #eef1f5;
}

.kv:last-child { border-bottom: none; }
.kv .k { color: #9aa3b2; }
.kv .v { color: #1f2733; text-align: right; }
.kv .v.bad { color: #e5484d; }
.kv .v.brand { color: #ff7a45; font-weight: 600; }

/* ── 趋势图 ─────────────────────────────────────────────────────────────── */
.chart-wrap {
  position: relative;
  margin-top: 20rpx;
  height: 200rpx;
}

.chart {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.bars {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
}

.bar-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
}

.bar-col {
  width: 100%;
  min-height: 4rpx;
  background: rgba(255, 122, 69, 0.16);
  border-radius: 6rpx 6rpx 0 0;
}

.bar-val { margin-bottom: 4rpx; }

/* ── 来源分布 ───────────────────────────────────────────────────────────── */
.src-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef1f5;
  font-size: 26rpx;
}

.src-row:last-child { border-bottom: none; }

.src-name { color: #1f2733; }
.src-count { color: #6b7484; font-variant-numeric: tabular-nums; }
