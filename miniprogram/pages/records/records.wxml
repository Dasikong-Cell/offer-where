<view class="page">

  <view class="card" wx:if="{{!configured}}">
    <view class="card-title">还没连上后端</view>
    <view class="card-sub">先填后端地址再查看职位记录。</view>
    <button class="btn btn-primary wide" bindtap="goConnect">去连接后端</button>
  </view>

  <block wx:else>

    <!-- 搜索 -->
    <view class="search-bar">
      <input class="search-input" type="text" placeholder="搜公司 / 职位 / 城市"
             value="{{keyword}}" bindinput="onKeyword" confirm-type="search" />
      <view class="search-clear" wx:if="{{keyword}}" bindtap="onClearKeyword">✕</view>
    </view>

    <!-- 来源筛选 -->
    <scroll-view class="filters" scroll-x enable-flex>
      <view class="filter-chip {{source === item.key ? 'active' : ''}}"
            wx:for="{{sourceFilters}}" wx:key="key"
            data-key="{{item.key}}" bindtap="onSourceTap">{{item.label}}</view>
    </scroll-view>

    <view class="count-line tiny muted2">
      共 {{filtered.length}} 条<block wx:if="{{filtered.length !== all.length}}">（筛选自 {{all.length}} 条）</block>
    </view>

    <view class="loading" wx:if="{{loading}}">正在读取…</view>

    <view class="card err-card" wx:elif="{{error}}">
      <view class="card-title">读取失败</view>
      <view class="err-text">{{error}}</view>
      <button class="btn btn-primary wide" bindtap="refresh">重试</button>
    </view>

    <view class="empty" wx:elif="{{filtered.length === 0}}">
      <view class="empty-title">没有记录</view>
      <view wx:if="{{all.length === 0}}">这台后端还没有投递记录，去控制台跑一轮投递吧。</view>
      <view wx:else>换个关键词或来源试试。</view>
    </view>

    <block wx:else>
      <view class="job-card" wx:for="{{visible}}" wx:key="id"
            data-id="{{item.id}}" bindtap="onJobTap">
        <view class="job-head">
          <view class="avatar">{{item.initial}}</view>
          <view class="job-head-main">
            <view class="job-title title-ellipsis">{{item.title || '未命名职位'}}</view>
            <view class="job-company title-ellipsis">{{item.company || '未知公司'}}</view>
          </view>
          <view class="badge {{item.statusCls}}">{{item.statusLabel}}</view>
        </view>

        <view class="job-meta">
          <text class="meta-item" wx:if="{{item.city}}">{{item.city}}</text>
          <text class="meta-item" wx:if="{{item.salary}}">{{item.salary}}</text>
          <text class="meta-item" wx:if="{{item.source}}">{{item.source}}</text>
          <text class="meta-item" wx:if="{{item.scoreText}}">匹配 {{item.scoreText}}</text>
        </view>

        <view class="job-foot tiny muted2">{{item.timeText}}</view>
      </view>

      <view class="load-more tiny muted2" wx:if="{{hasMore}}" bindtap="loadMore">
        上拉加载更多 · 已显示 {{visible.length}} / {{filtered.length}}
      </view>
      <view class="load-more tiny muted2" wx:else>已到底部 · 共 {{filtered.length}} 条</view>
    </block>

  </block>

</view>
