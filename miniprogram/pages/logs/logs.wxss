.search-bar {
  position: relative;
  margin-bottom: 20rpx;
}

.search-input {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 76rpx 0 26rpx;
  background: #ffffff;
  border: 1rpx solid #e8ebf0;
  border-radius: 999rpx;
  font-size: 27rpx;
  color: #1f2733;
  width: 100%;
}

.search-clear {
  position: absolute;
  right: 10rpx;
  top: 0;
  width: 64rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  color: #9aa3b2;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.chips.scroll {
  white-space: nowrap;
  display: block;
}

.chip {
  display: inline-block;
  padding: 10rpx 26rpx;
  background: #ffffff;
  border: 1rpx solid #e8ebf0;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: #6b7484;
  margin-right: 14rpx;
}

.chip.active {
  background: #fff1ea;
  border-color: #ffd0bb;
  color: #ff5e3a;
}

.count-line {
  padding: 12rpx 8rpx 12rpx;
}

/* ── 日志框：深底浅字，与终端观感一致，便于扫读 ─────────────────────────────
   注意用的是自定义深色（不跟随系统主题），因为日志的阅读习惯就是深色终端。 */
.log-box {
  background: #1c2333;
  border-radius: 20rpx;
  padding: 10rpx 0;
  overflow: hidden;
}

.log-line {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 22rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.log-line:last-child { border-bottom: none; }

.log-ts {
  flex: none;
  width: 130rpx;
  font-family: Consolas, Menlo, monospace;
  font-size: 22rpx;
  color: #6f7a8d;
  padding-top: 3rpx;
}

.log-lv {
  flex: none;
  width: 92rpx;
  font-family: Consolas, Menlo, monospace;
  font-size: 21rpx;
  padding-top: 3rpx;
}

.lv-error { color: #ff6b6f; }
.lv-warn { color: #f0a33a; }
.lv-info { color: #7f8b9e; }

.log-msg {
  flex: 1;
  min-width: 0;
  font-family: Consolas, Menlo, monospace;
  font-size: 23rpx;
  color: #c8d0dd;
  line-height: 1.55;
  word-break: break-word;
}

.foot-hint {
  text-align: center;
  padding: 26rpx 0;
}

.err-card { border-color: #f6c9ca; }

.err-text {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #e5484d;
}

.btn.wide {
  margin-top: 24rpx;
  width: 100%;
}
