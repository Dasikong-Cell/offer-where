<view class="page">

  <view class="card" wx:if="{{!configured}}">
    <view class="card-title">还没连上后端</view>
    <view class="card-sub">先填后端地址再查看日志。</view>
    <button class="btn btn-primary wide" bindtap="goConnect">去连接后端</button>
  </view>

  <block wx:else>

    <!-- 搜索 -->
    <view class="search-bar">
      <input class="search-input" type="text" placeholder="搜日志内容，回车确认"
             value="{{keyword}}" bindinput="onKeyword" bindconfirm="onSearchConfirm"
             confirm-type="search" />
      <view class="search-clear" wx:if="{{keyword}}" bindtap="onClearKeyword">✕</view>
    </view>

    <!-- 级别 -->
    <view class="chips">
      <view class="chip {{level === item.key ? 'active' : ''}}"
            wx:for="{{levels}}" wx:key="key"
            data-key="{{item.key}}" bindtap="onLevelTap">{{item.label}}</view>
    </view>

    <!-- 日期 -->
    <scroll-view class="chips scroll" scroll-x wx:if="{{dates.length > 0}}">
      <view class="chip {{date === item ? 'active' : ''}}"
            wx:for="{{dates}}" wx:key="*this"
            data-date="{{item}}" bindtap="onDateTap">{{item}}</view>
    </scroll-view>

    <view class="count-line tiny muted2">
      显示 {{lines.length}} 条 · 共 {{total}} 条
    </view>

    <view class="loading" wx:if="{{loading}}">正在读取…</view>

    <view class="card err-card" wx:elif="{{error}}">
      <view class="card-title">读取失败</view>
      <view class="err-text">{{error}}</view>
      <button class="btn btn-primary wide" bindtap="refresh">重试</button>
    </view>

    <view class="empty" wx:elif="{{lines.length === 0}}">
      <view class="empty-title">没有日志</view>
      <view>换个级别或清空关键词试试。</view>
    </view>

    <block wx:else>
      <view class="log-box">
        <view class="log-line" wx:for="{{lines}}" wx:key="index"
              data-idx="{{index}}" bindlongpress="copyLine">
          <text class="log-ts">{{item.ts}}</text>
          <text class="log-lv {{item.levelCls}}">{{item.level}}</text>
          <text class="log-msg">{{item.msg}}</text>
        </view>
      </view>
      <view class="foot-hint tiny muted2">长按某行可复制该条日志</view>
    </block>

  </block>

</view>
