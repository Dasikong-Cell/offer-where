{
  "description": "OfferWhere 小程序项目配置。appid 使用测试号占位，接入正式 AppID 后替换即可。",
  "appid": "touristappid",
  "projectname": "offer-where-miniprogram",
  "compileType": "miniprogram",
  "miniprogramRoot": "./",
  "libVersion": "latest",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "minifyWXSS": true,
    "minifyWXML": true,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "ignoreUploadUnusedFiles": true,
    "checkInvalidKey": true,
    "coverView": true,
    "lazyloadPlaceholderEnable": false,
    "preloadBackgroundData": false,
    "autoAudits": false,
    "showShadowRootInWxmlPanel": true,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    },
    "useCompilerPlugins": false,
    "ignoreDevUnusedFiles": false
  },
  "condition": {
    "miniprogram": {
      "list": []
    }
  },
  "packOptions": {
    "ignore": [
      {
        "type": "file",
        "value": "project.config.json"
      },
      {
        "type": "file",
        "value": "project.private.config.json"
      },
      {
        "type": "file",
        "value": "README.md"
      }
    ],
    "include": []
  }
}
