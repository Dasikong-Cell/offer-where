# ===== CodeBuddy Agent SDK 认证 =====
# 方式一（推荐）：使用 API Key
CODEBUDDY_API_KEY=
# 方式二：使用 Auth Token（与 API Key 二选一）
# CODEBUDDY_AUTH_TOKEN=

# 可选：自定义网关
# CODEBUDDY_BASE_URL=
# CODEBUDDY_INTERNET_ENVIRONMENT=external

# ===== 应用配置 =====
# 端口：须与投递/采集脚本、控制台的 4400 约定一致（改这里也要同步改脚本，否则控制台连不上后端）
PORT=4400
# 监听地址：默认仅本机回环；如需局域网/手机等其它设备访问，显式设 HOST=0.0.0.0（会暴露到内网，谨慎）
# HOST=127.0.0.1
# 局域网多人共用：把「对方浏览器访问本服务的来源地址」加进白名单（逗号分隔），否则写操作会被 403。
# 例：HOST=0.0.0.0 且 EXTRA_ORIGINS=http://192.168.1.20:4400,http://192.168.1.31:4400
# 注意：公网/多租户（账号体系、数据隔离）不在支持范围，请勿直接暴露到公网。
# EXTRA_ORIGINS=
# 暴露给 Agent 的本机能力地址（默认 http://127.0.0.1:4400）
# APP_PUBLIC_URL=http://127.0.0.1:4400

# ===== 邮箱验证码（可选，也可在「我的档案」页面配置，页面配置优先）=====
# QQ 邮箱需在 设置-账户 中开启 IMAP/SMTP 服务后获取 16 位授权码
# MAIL_USER=123456@qq.com
# MAIL_AUTH_CODE=abcdefghijklmnop
# MAIL_IMAP_HOST=imap.qq.com
# MAIL_IMAP_PORT=993

# ===== 浏览器自动化 =====
# 是否允许 Agent 执行页面内 JS（默认允许）
# ALLOW_BROWSER_EVAL=false

# ===== AI 能力（对标职得鸭：智能匹配 + 文案撰写）=====
# 统一的 OpenAI 兼容大模型网关；三者齐备才启用 AI，否则自动回退「规则匹配 + 模板文案」。
# 兼容：OpenAI / DeepSeek / SiliconFlow / 通义 / 智谱 / Groq / 本地 Ollama 等。
# 本地 Ollama 示例：LLM_BASE_URL=http://127.0.0.1:11434/v1  LLM_MODEL=qwen2.5:7b（无需 API Key）
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-4o-mini
# 兼容早期「职得鸭远程」文案端点（可选，优先级低于上面的本地 LLM）：
# AI_LETTER_ENDPOINT=https://your-host/api/ai/letter
