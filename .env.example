# ===== CodeBuddy Agent SDK 认证 =====
# 方式一（推荐）：使用 API Key
CODEBUDDY_API_KEY=
# 方式二：使用 Auth Token（与 API Key 二选一）
# CODEBUDDY_AUTH_TOKEN=

# 可选：自定义网关
# CODEBUDDY_BASE_URL=
# CODEBUDDY_INTERNET_ENVIRONMENT=external

# ===== 应用配置 =====
PORT=3000
# 暴露给 Agent 的本机能力地址（默认 http://127.0.0.1:3000）
# APP_PUBLIC_URL=http://127.0.0.1:3000

# ===== 邮箱验证码（可选，也可在「我的档案」页面配置，页面配置优先）=====
# QQ 邮箱需在 设置-账户 中开启 IMAP/SMTP 服务后获取 16 位授权码
# MAIL_USER=123456@qq.com
# MAIL_AUTH_CODE=abcdefghijklmnop
# MAIL_IMAP_HOST=imap.qq.com
# MAIL_IMAP_PORT=993

# ===== 浏览器自动化 =====
# 是否允许 Agent 执行页面内 JS（默认允许）
# ALLOW_BROWSER_EVAL=false
