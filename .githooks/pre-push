#!/bin/sh
# ============================================================================
# pre-push 静态防线
#
# 为什么必须有：服务端用 `tsx` 直跑 `.ts`，**完全不做类型检查** —— 类型错误在运行期
# 毫无异常、冒烟测试全绿，但 `tsc -b`（npm run build）会直接失败。
# 2026-09-19 测评实测踩到：给 jobs 加 quarantine 列时漏改 JobRow 接口，
# 运行时一切正常，构建却长期是坏的，直到一次软件测评才发现。
#
# 为什么还要加 PII 扫描（2026-09-27）：仓库发布前只有这一道门是「会被 git 推送」的
# 位置，而投递类项目的源码天然会带真实简历信息。实测踩到两次：先是简历本人姓名被
# 硬编码进页面注入脚本（随包发给每个收件人），修完又发现「只改了文件名、没洗内容」——
# docs/ 下的转录行原样留在公开仓库里。两次都是**全绿通过**：一次因为打包检查只覆盖
# 「会进包的文件」，一次因为它只查文件名。凡 git 跟踪的东西（含历史）都会被推送、
# 被浏览、被抓取，"不发包" ≠ "不公开"。判定数据放在 gitignore 的 data/ 里，
# 所以这条钩子本身不含它要找的字符串。
#
# 启用：npm run hooks:install   （即 git config core.hooksPath .githooks）
# 跳过：git push --no-verify    （请自行确认风险）
# ============================================================================
set -e

NODE=node
if [ -x "./node/node.exe" ]; then NODE="./node/node.exe"; fi
if ! command -v "$NODE" >/dev/null 2>&1; then
  echo "⚠️  未找到可用 node，跳过 pre-push 检查（不影响推送）"
  exit 0
fi
if [ ! -f node_modules/typescript/bin/tsc ]; then
  echo "⚠️  未安装依赖（node_modules 缺失），跳过 pre-push 检查。先跑 npm install。"
  exit 0
fi

echo "▶ pre-push [1/4] 类型检查（tsc -b，含 server/）..."
if ! "$NODE" node_modules/typescript/bin/tsc -b; then
  echo ""
  echo "❌ 类型检查失败。服务端 tsx 不做类型检查，这里失败 = 构建是坏的，必须修。"
  exit 1
fi

echo "▶ pre-push [2/4] 控制台内联 JS 语法检查..."
if ! "$NODE" node_modules/tsx/dist/cli.mjs scripts/check_console_syntax.ts; then
  echo ""
  echo "❌ public/console.html 内联脚本有语法错误（嵌套模板字面量最容易漏括号）。"
  exit 1
fi

echo "▶ pre-push [3/4] 小程序静态自检（页面注册/tabBar/路由/事件绑定/模板变量）..."
# 为什么放在推送前：小程序白屏与「点了没反应」绝大多数是**静态可查**的问题
# （app.json 里写了不存在的页面、wxml 绑的方法没定义、switchTab 指向非 tabBar 页），
# 而这类错误在微信开发者工具里只表现为界面不动，靠肉眼很难定位。
if ! "$NODE" node_modules/tsx/dist/cli.mjs scripts/mp_check.ts; then
  echo ""
  echo "❌ 小程序静态自检失败，见上方 ✗ 项。"
  exit 1
fi

echo "▶ pre-push [4/4] 全仓库 PII 扫描..."
# 文件列表由 shell 喂进去（git ls-files 在 node 里 spawn 会 EBUSY，见 scripts/pii_guard.ts 文件头）。
# core.quotePath=false：否则 CJK 路径会被输出成 "\344\275\277..." 转义，脚本按字面去找必然找不到。
if ! git -c core.quotePath=false ls-files | "$NODE" node_modules/tsx/dist/cli.mjs scripts/pii_guard.ts --stdin; then
  echo ""
  echo "❌ git 跟踪的文件里含 data/.pii_denylist.txt 列出的个人信息。"
  echo "   推送 = 同时写进 gitee/github 的公开历史，改写历史也无法真正收回。"
  echo "   把具体值换成占位符后重试（见 scripts/pii_guard.ts 顶部说明）。"
  exit 1
fi

echo "✅ pre-push 检查通过"
