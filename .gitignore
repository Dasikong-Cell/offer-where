# ── 依赖 ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── 构建产物 ──────────────────────────────────────────
dist/
build/
*.tsbuildinfo
tsconfig.node.tsbuildinfo

# ── 原生外壳产物（Tauri）──────────────────────────────
# 这里**故意只放行三个文件**，其余（尤其 offer-where.log / .prev 运行日志）继续忽略。
# 注意写法：必须先写 `dist-app/*` 再用 `!` 放行单个文件。
# 若写成 `dist-app/`（排除目录本身），Git 规则「父目录被排除时无法重新包含其下文件」
# 会让下面三条 `!` 全部失效 —— 这是个静默失败，所以别"简化"它。
# 为什么二进制要入库：便携包与桌面入口都指向它，而 `.gitignore` 掉它会让
# CI（release.yml 在 windows-latest 上跑 pack.ps1）拿不到产物。
# 源码与二进制的对应关系由 build_app.ps1 写进 BUILD_INFO.json，
# 并由 pack.ps1 的 provenance 断言强制校验（不一致直接 fail-closed）。
dist-app/*
!dist-app/offer-where.exe
!dist-app/WebView2Loader.dll
!dist-app/BUILD_INFO.json

# vite.config.ts 的编译产物（源文件是 vite.config.ts）
vite.config.js
vite.config.d.ts

# tsc -b 生成的类型声明文件（源文件是同名 .ts；前端 src/ 下无此类文件）
server/**/*.d.ts
shared/**/*.d.ts

# tsc -b 生成的 JS 编译产物（运行用 tsx 跑 .ts，不依赖编译产物；与 .d.ts 同理）
server/**/*.js
shared/**/*.js

# shared/agentPrompt.ts 的编译产物（注意：postcss.config.js / tailwind.config.js 是真实配置，保留）
shared/agentPrompt.js

# ── 日志 ──────────────────────────────────────────────
*.log
build.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── 敏感数据（务必不要上传）────────────────────────────
# data/ 目录下包含：
#   browser/       浏览器持久会话(约 386MB)，保存智联/BOSS/51job/猎聘的登录 Cookie
#   chat.db        SQLite 数据库：mail_config.auth_code(邮箱授权码)、
#                  profile(个人简历)、applications(投递记录)
#   screenshots/   投递过程截图，含个人与岗位信息
#   *_result*.json 投递运行结果日志
# 注意：应用启动会自动重建 data/ 目录与 chat.db（见 server/db.ts），
#       因此忽略该目录不会影响新克隆项目的运行。
data/

# ── 环境变量 ──────────────────────────────────────────
.env
.env.*
!.env.example

# ── 打包时生成的构建标识（pack.ps1 写入并打进 zip，不入库）──
version.json

# ── 本机会话记忆 / 本地技能（工作区状态的副本，因人而异，不该入库）──
.workbuddy/

# ── 临时调试脚本（未被任何源码引用）─────────────────────
# _tools/ 是本机排查/一次性工具目录（如离线用 Git Data API 推送的 gh_api_push.mjs、
# 复现 CI 哈希差异的诊断脚本）。它只服务本机调试，不属于产品源码，也不该进包。
_tools/
_dbinspect.cjs
_dbjobs.cjs
_dbprofile.cjs
_parse_resume.cjs
_update_profile.cjs
_update_profile2.cjs
_probe_*.cjs
_gaga_*.cjs
# .ts 版临时探针：命名以 `_` 开头即视为一次性，不入库
# （历史上 scripts/_probe_pos.ts 被误提交并留存很久，内含硬编码人名过滤，属噪音）
scripts/_probe_*.ts
scripts/_tmp_*.ts
_probe_*.ts
_tmp_*.ts
# 同上，但命名不带前导下划线（历史上 scripts/probe_*.ts 漏网会被提交）
scripts/*probe*.ts
scripts/*_tmp*.ts

# 小程序 ↔ 后端契约实测（**有意入库**，不是一次性探针）。
# 命名带前导下划线只为表明「不参与 npm test 主流程」，但它必须长期存在：
# 小程序页面读的是后端原始 snake_case 字段（position / apply_url / match_score），
# 写错时 wxml 静默渲染空白、静态检查全绿 —— 它第一次跑就抓出了 title vs position。
# 注意用 ! 放行，否则会被上面的 scripts/*probe*.ts 规则吃掉。
!scripts/_mp_api_probe.mts

# ── 编辑器 / 系统文件 ─────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ── 自带 Node 运行时（打包进 zip 分发用，不入库以免膨胀远端）──
node/

# ── 自解压外壳的编译产物（tools/sfx/offerwhere_sfx.c 是源，入库；产物不入库）──
tools/sfx/build/

# ── 临时校验脚本 ──────────────────────────────────────
test_env.bat

# ── GitHub Git Data API 推送用的离线导出（export_commit.sh 产出）──
# 里面是变更 blob 的原始字节，含 .env.example 等文件的副本；
# 不入库（体积+会随每次推送重建），但**必须忽略**，否则 PII 扫描与打包会扫到它的一份影子副本。
_push2/
